{% comment %}
  Gift Guide Banner Section
  =========================
  Built from scratch — no Dawn components/snippets used, per test requirements.

  Layout (matches Figma spec):
    - Full-width background: white with line-art illustration images
    - Top utility bar: logo (left) + subtext (center) + yellow CTA (right)
    - Main hero content: heading + description + black CTA (left-aligned)
    - Bottom scrolling ticker bar

  Background images (gift-guide-bg-top.png / gift-guide-bg-bottom.png) are
  hardcoded as static assets because they are decorative illustrations that
  are part of the page design, not merchant-editable content. The merchant
  CAN still override them via the optional image picker in the customizer.

  Dimensions from Figma:
    Banner:  1440 × 878px
    Heading: Jost 500, 70px, #000, line-height 100%
    Subtext: Jost 400, 20px, #000, line-height 140%
    Yellow button: 207 × 44px, #FFF544
    Black button:  220 × 50px, #000, at left:67 top:743
{% endcomment %}

<section class="gift-banner" style="background-color: {{ section.settings.background_color }};">
  {%- comment -%}
    Background illustration — two image halves that tile vertically
    to cover the full 878px banner height. If the merchant uploads
    a custom background via the customizer, it takes priority.
  {%- endcomment -%}
  {% if section.settings.background_image %}
    <div class="gift-banner__bg">
      {{ section.settings.background_image | image_url: width: 1440 | image_tag:
        loading: 'eager',
        alt: section.settings.heading,
        class: 'gift-banner__bg-img'
      }}
    </div>
  {% else %}
    <div class="gift-banner__bg gift-banner__bg--illustrations">
      <img
        src="{{ 'gift-guide-bg-top.png' | asset_url }}"
        alt=""
        class="gift-banner__bg-tile gift-banner__bg-tile--top"
        loading="eager"
        aria-hidden="true"
      >
      <img
        src="{{ 'gift-guide-bg-bottom.png' | asset_url }}"
        alt=""
        class="gift-banner__bg-tile gift-banner__bg-tile--bottom"
        loading="eager"
        aria-hidden="true"
      >
    </div>
  {% endif %}

  {%- comment -%} ---- Top utility bar ---- {%- endcomment -%}
  <div class="gift-banner__top">
    <p class="gift-banner__logo">{{ section.settings.logo_text }}</p>
    <p class="gift-banner__top-subtext">{{ section.settings.top_subtext }}</p>

    <a href="{{ section.settings.top_button_link | default: '#' }}" class="gift-banner__btn gift-banner__btn--yellow">
      <span class="gift-banner__btn-accent" aria-hidden="true"></span>
      <span class="gift-banner__btn-label">{{ section.settings.top_button_text }}</span>
      <span class="gift-banner__btn-dash" aria-hidden="true"></span>
    </a>
  </div>

  {%- comment -%} ---- Main hero content ---- {%- endcomment -%}
  <div class="gift-banner__content">
    <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
    <div class="gift-banner__description">{{ section.settings.description }}</div>

    <a href="{{ section.settings.cta_link | default: '#' }}" class="gift-banner__btn gift-banner__btn--black">
      <span class="gift-banner__btn-accent" aria-hidden="true"></span>
      <span class="gift-banner__btn-label">{{ section.settings.cta_text }}</span>
      <span class="gift-banner__btn-dash" aria-hidden="true"></span>
    </a>
  </div>

  {%- comment -%} ---- Bottom scrolling ticker ---- {%- endcomment -%}
  {% if section.settings.ticker_text != blank %}
    <div class="gift-banner__ticker" aria-hidden="true">
      <div class="gift-banner__ticker-track">
        {% comment %} Duplicated 6× for seamless infinite scroll loop {% endcomment %}
        {% for i in (1..6) %}
          <span class="gift-banner__ticker-item">{{ section.settings.ticker_text }}</span>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  /* ============================================================
   * Gift Guide Banner — Styles
   * ============================================================
   * All dimensions match the Figma spec provided by the client.
   * Font: Jost (loaded via Google Fonts in the asset CSS).
   * ============================================================ */

  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap');

  /* ---- Section Container ---- */
  .gift-banner {
    position: relative;
    width: 100%;
    max-width: 1440px;
    height: 878px;
    margin: 0 auto;
    overflow: hidden;
    font-family: 'Jost', sans-serif;
    background-color: #fff;
  }

  /* ---- Background ---- */
  /* Single custom image (merchant-uploaded via customizer) */
  .gift-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gift-banner__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Default illustration background — two tiled halves.
     Top image sits in the upper portion, bottom image below.
     Together they fill the 878px banner seamlessly. */
  .gift-banner__bg--illustrations {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .gift-banner__bg-tile {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  /* Top tile: takes up roughly the upper 50% of the banner */
  .gift-banner__bg-tile--top {
    height: 50%;
    object-position: center top;
  }

  /* Bottom tile: fills the remaining lower portion */
  .gift-banner__bg-tile--bottom {
    height: 50%;
    object-position: center top;
  }

  /* ============================================================
   * Top Utility Bar
   * ============================================================
   * Figma: flex row, items spaced between, padding 24px 67px.
   * Logo left, subtext centered, yellow CTA right.
   * ============================================================ */
  .gift-banner__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 67px 0;
  }

  .gift-banner__logo {
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000;
    margin: 0;
    white-space: nowrap;
  }

  .gift-banner__top-subtext {
    font-weight: 400;
    font-size: 16px;
    line-height: 140%;
    color: #000;
    margin: 0;
    flex: 1;
    text-align: center;
  }

  /* ============================================================
   * Buttons — Shared Base
   * ============================================================
   * Both buttons share the same Figma structure:
   *   1. Left accent line (Rectangle 26036 — thin vertical border)
   *   2. Centered uppercase text label
   *   3. Right-side horizontal dash (Line 15 — minimal arrow indicator)
   *
   * Hover animation (Smart Animate 300ms ease-out):
   *   - Dash slides right
   *   - Label shifts left
   * ============================================================ */
  .gift-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    text-transform: uppercase;
    border-radius: 0;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Left accent line (Rectangle 26036)
     Figma: 0.48% wide ≈ 1px thin vertical accent. */
  .gift-banner__btn-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: currentColor;
    opacity: 0.3;
  }

  /* Button label — centered text that shifts left on hover */
  .gift-banner__btn-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    text-align: center;
    transition: transform 300ms ease-out;
  }

  /* Right-side horizontal dash (Line 15)
     Figma: left:77.78%, right:10.63%, vertically centered.
     Acts as a minimal arrow indicator → slides right on hover. */
  .gift-banner__btn-dash {
    position: absolute;
    left: 77.78%;
    right: 10.63%;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transform: translateY(-50%);
    transition: transform 300ms ease-out;
  }

  /* Hover — mirrors Figma Smart Animate 300ms ease-out */
  .gift-banner__btn:hover .gift-banner__btn-dash {
    transform: translateY(-50%) translateX(4px);
  }

  .gift-banner__btn:hover .gift-banner__btn-label {
    transform: translateX(-4px);
  }

  /* ---- Yellow Button (top bar — "CHOOSE GIFT") ---- */
  .gift-banner__btn--yellow {
    width: 207px;
    height: 44px;
    background-color: #FFF544;
    color: #000;
    font-size: 15px;
  }

  /* ---- Black Button ("SHOP NOW") ----
     Figma: 220×50px, positioned absolutely at left:67, top:743. */
  .gift-banner__btn--black {
    position: absolute;
    top: 743px;
    left: 67px;
    width: 220px;
    height: 50px;
    background-color: #000;
    color: #fff;
    font-size: 16px;
    z-index: 2;
  }

  /* ============================================================
   * Main Hero Content
   * ============================================================
   * Figma: left-aligned text block over the illustrations.
   * Heading: Jost 500 / 70px / #000 / line-height 100%
   * Description: Jost 400 / 20px / #000 / line-height 140%
   * ============================================================ */
  .gift-banner__content {
    position: relative;
    z-index: 2;
    padding: 100px 67px 0;
    max-width: 640px;
  }

  .gift-banner__heading {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 70px;
    line-height: 100%;
    color: #000;
    margin: 0 0 24px;
  }

  .gift-banner__description {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #000;
    margin: 0 0 40px;
  }

  /* ============================================================
   * Bottom Ticker
   * ============================================================
   * Black bar at the absolute bottom. Text scrolls infinitely
   * left via CSS animation (duplicated 6× for seamless loop).
   * ============================================================ */
  .gift-banner__ticker {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #000;
    overflow: hidden;
    z-index: 2;
    padding: 12px 0;
  }

  .gift-banner__ticker-track {
    display: flex;
    width: max-content;
    animation: gift-ticker-scroll 20s linear infinite;
  }

  .gift-banner__ticker-item {
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0 40px;
  }

  @keyframes gift-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Accessibility: respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .gift-banner__ticker-track { animation: none; }
    .gift-banner__btn-dash,
    .gift-banner__btn-label { transition: none; }
  }

  /* ============================================================
   * Mobile Responsive (≤749px)
   * ============================================================ */
  @media screen and (max-width: 749px) {
    .gift-banner {
      height: auto;
      min-height: 100vh;
    }

    .gift-banner__bg--illustrations {
      /* On mobile, let illustrations fill and overflow naturally */
      min-height: 100%;
    }

    .gift-banner__bg-tile--top,
    .gift-banner__bg-tile--bottom {
      height: auto;
      min-height: 300px;
    }

    .gift-banner__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 16px 24px 0;
    }

    .gift-banner__top-subtext {
      text-align: left;
    }

    .gift-banner__content {
      padding: 40px 24px 140px;
      max-width: 100%;
    }

    .gift-banner__heading {
      font-size: 36px;
    }

    .gift-banner__description {
      font-size: 16px;
    }

    .gift-banner__btn--black {
      position: static;
      width: 100%;
      margin-top: 24px;
    }

    .gift-banner__btn--yellow {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "class": "section-gift-banner",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Custom background image",
      "info": "Optional — overrides the default line-art illustrations. Use 1440×878px for best results."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Tisso Vison"
    },
    {
      "type": "text",
      "id": "top_subtext",
      "label": "Top subtext",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "header",
      "content": "Main content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Bottom button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bottom button link"
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
