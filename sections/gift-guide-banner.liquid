{% comment %}
  Gift Guide Banner Section
  Built from scratch — no Dawn components/snippets used, per test requirements.
  Contains: top utility bar (logo + subtext + yellow CTA), main hero content
  (heading + description + black CTA), and a bottom scrolling ticker.
{% endcomment %}

<section class="gift-banner" style="background-color: {{ section.settings.background_color }};">
  {% if section.settings.background_image %}
    <div class="gift-banner__bg">
      {{ section.settings.background_image | image_url: width: 1440 | image_tag:
        loading: 'lazy',
        alt: section.settings.heading,
        class: 'gift-banner__bg-img'
      }}
    </div>
  {% endif %}

  <div class="gift-banner__top">
    <p class="gift-banner__logo">{{ section.settings.logo_text }}</p>
    <p class="gift-banner__top-subtext">{{ section.settings.top_subtext }}</p>

    <a href="{{ section.settings.top_button_link | default: '#' }}" class="gift-banner__btn gift-banner__btn--yellow">
      <span class="gift-banner__btn-accent" aria-hidden="true"></span>
      <span class="gift-banner__btn-label">{{ section.settings.top_button_text }}</span>
      <span class="gift-banner__btn-dash" aria-hidden="true"></span>
    </a>
  </div>

  <div class="gift-banner__content">
    <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
    <div class="gift-banner__description">{{ section.settings.description }}</div>

    <a href="{{ section.settings.cta_link | default: '#' }}" class="gift-banner__btn gift-banner__btn--black">
      <span class="gift-banner__btn-accent" aria-hidden="true"></span>
      <span class="gift-banner__btn-label">{{ section.settings.cta_text }}</span>
      <span class="gift-banner__btn-dash" aria-hidden="true"></span>
    </a>
  </div>

  {% if section.settings.ticker_text != blank %}
    <div class="gift-banner__ticker" aria-hidden="true">
      <div class="gift-banner__ticker-track">
        {% comment %} Duplicated for seamless infinite scroll {% endcomment %}
        {% for i in (1..6) %}
          <span class="gift-banner__ticker-item">{{ section.settings.ticker_text }}</span>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  .gift-banner {
    position: relative;
    width: 100%;
    max-width: 1440px;
    height: 878px;
    margin: 0 auto;
    overflow: hidden;
    font-family: 'Jost', sans-serif;
  }

  .gift-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gift-banner__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* --- Top utility bar --- */
  .gift-banner__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 67px 0;
  }

  .gift-banner__logo {
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000;
    margin: 0;
  }

  .gift-banner__top-subtext {
    font-weight: 400;
    font-size: 16px;
    line-height: 140%;
    color: #000;
    margin: 0;
    flex: 1;
    text-align: center;
  }

  /* --- Buttons (shared base) ---
     Both buttons share the same internal structure from Figma:
       1. Left accent line (Rectangle 26036 — thin vertical border)
       2. Centered text label ("choose yours" / "choose gift")
       3. Right-side horizontal dash (Line 15 — acts as a minimal arrow indicator)
     Hover animation (300ms ease-out): dash slides right, label shifts left.
  */
  .gift-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    text-transform: uppercase;
    border-radius: 0;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* --- Left accent line (Rectangle 26036) ---
     Figma: left:0%, right:99.52% → ~0.48% wide = ~1px.
     A thin vertical accent on the left edge of the button. */
  .gift-banner__btn-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: currentColor;
    opacity: 0.3;
  }

  /* --- Button label ---
     Figma: centered text, shifts left on hover (Smart Animate). */
  .gift-banner__btn-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    text-align: center;
    transition: transform 300ms ease-out;
  }

  /* --- Right-side horizontal dash (Line 15) ---
     Figma: left:77.78%, right:10.63%, vertically centered.
     This is a decorative dash that acts as a minimal arrow indicator.
     On hover it slides further right. */
  .gift-banner__btn-dash {
    position: absolute;
    left: 77.78%;
    right: 10.63%;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transform: translateY(-50%);
    transition: transform 300ms ease-out;
  }

  /* --- Hover animation (both buttons) ---
     Mirrors Figma "Change to Variant 2 / Smart Animate 300ms ease-out":
     dash slides right, label shifts left. */
  .gift-banner__btn:hover .gift-banner__btn-dash {
    transform: translateY(-50%) translateX(4px);
  }

  .gift-banner__btn:hover .gift-banner__btn-label {
    transform: translateX(-4px);
  }

  /* --- Yellow button (top bar CTA) --- */
  .gift-banner__btn--yellow {
    width: 207px;
    height: 44px;
    background-color: #FFF544;
    color: #000;
    font-size: 15px;
  }

  /* --- Black button ("Shop now" / "choose yours") ---
     Figma: 220×50px, positioned at left:67px, top:743px. */
  .gift-banner__btn--black {
    position: absolute;
    top: 743px;
    left: 67px;
    width: 220px;
    height: 50px;
    background-color: #000;
    color: #fff;
    font-size: 16px;
    z-index: 2;
  }

  /* --- Main hero content --- */
  .gift-banner__content {
    position: relative;
    z-index: 2;
    padding: 100px 67px 0;
    max-width: 640px;
  }

  .gift-banner__heading {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 70px;
    line-height: 100%;
    color: #000;
    margin: 0 0 24px;
  }

  .gift-banner__description {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #000;
    margin: 0 0 40px;
  }

  /* --- Ticker --- */
  .gift-banner__ticker {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #000;
    overflow: hidden;
    z-index: 2;
    padding: 12px 0;
  }

  .gift-banner__ticker-track {
    display: flex;
    width: max-content;
    animation: gift-ticker-scroll 20s linear infinite;
  }

  .gift-banner__ticker-item {
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0 40px;
  }

  @keyframes gift-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift-banner__ticker-track { animation: none; }
    .gift-banner__btn-dash,
    .gift-banner__btn-label { transition: none; }
  }

  /* --- Mobile --- */
  @media screen and (max-width: 749px) {
    .gift-banner {
      height: auto;
      min-height: 100vh;
    }

    .gift-banner__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 16px 24px 0;
    }

    .gift-banner__top-subtext {
      text-align: left;
    }

    .gift-banner__content {
      padding: 40px 24px 140px;
      max-width: 100%;
    }

    .gift-banner__heading {
      font-size: 36px;
    }

    .gift-banner__description {
      font-size: 16px;
    }

    .gift-banner__btn--black {
      position: static;
      width: 100%;
      margin-top: 24px;
    }

    .gift-banner__btn--yellow {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "class": "section-gift-banner",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Tisso Vison"
    },
    {
      "type": "text",
      "id": "top_subtext",
      "label": "Top subtext",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "header",
      "content": "Main content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Bottom button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bottom button link"
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
