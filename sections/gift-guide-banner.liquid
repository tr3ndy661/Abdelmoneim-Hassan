{% comment %}
  Gift Guide Banner Section
  =========================
  Built entirely from scratch — no Dawn components/snippets.

  Layout (from Figma CSS export):
    Section:  1440 × 878px (64px top bar + 780px content area + 34px ticker)
    Top bar:  TISSO VISON (left) | subtext (center) | yellow CTA (right)
    Content:  Two illustration images tiled asymmetrically:
              - Frame.png:    1440×390, top-left (full width, top half)
              - Frame(1).png: 890×402, at left:550 top:378 (bottom-RIGHT only)
              This leaves the bottom-left quadrant as clean white space
              for the heading, description, and black CTA button.
    Ticker:   Black bar at the absolute bottom, scrolling text.

  All positions use the Figma export values with a +64px vertical offset
  to account for the top bar area (confirmed by button position: 679+64=743).
{% endcomment %}

<section class="gift-banner" style="background-color: {{ section.settings.background_color }};">

  {%- comment -%} ---- Background Illustrations ----
    Two images compose the background. They are NOT full-bleed —
    Frame(1).png is offset right (left:550px) to deliberately leave
    the bottom-left clear for the text content overlay.
  {%- endcomment -%}
  {% if section.settings.background_image %}
    {%- comment -%} Custom image override from customizer {%- endcomment -%}
    <img
      src="{{ section.settings.background_image | image_url: width: 1440 }}"
      alt="{{ section.settings.heading | escape }}"
      class="gift-banner__illus gift-banner__illus--custom"
      loading="eager"
    >
  {% else %}
    <img
      src="{{ 'gift-guide-bg-top.png' | asset_url }}"
      alt=""
      aria-hidden="true"
      class="gift-banner__illus gift-banner__illus--top"
      loading="eager"
    >
    <img
      src="{{ 'gift-guide-bg-bottom.png' | asset_url }}"
      alt=""
      aria-hidden="true"
      class="gift-banner__illus gift-banner__illus--bottom"
      loading="eager"
    >
  {% endif %}

  {%- comment -%} ---- Top Utility Bar ---- {%- endcomment -%}
  <div class="gift-banner__top">
    <p class="gift-banner__logo">{{ section.settings.logo_text }}</p>
    <p class="gift-banner__top-subtext">{{ section.settings.top_subtext }}</p>
    <a href="{{ section.settings.top_button_link | default: '#' }}" class="gift-banner__btn gift-banner__btn--yellow">
      <span class="gift-banner__btn-label">{{ section.settings.top_button_text }}</span>
      <span class="gift-banner__btn-dash" aria-hidden="true"></span>
    </a>
  </div>

  {%- comment -%} ---- Heading ---- {%- endcomment -%}
  <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>

  {%- comment -%} ---- Description ---- {%- endcomment -%}
  <div class="gift-banner__description">{{ section.settings.description }}</div>

  {%- comment -%} ---- Black CTA Button ---- {%- endcomment -%}
  <a href="{{ section.settings.cta_link | default: '#' }}" class="gift-banner__btn gift-banner__btn--black">
    <span class="gift-banner__btn-label">{{ section.settings.cta_text }}</span>
    <span class="gift-banner__btn-dash" aria-hidden="true"></span>
  </a>

  {%- comment -%} ---- Bottom Scrolling Ticker ---- {%- endcomment -%}
  {% if section.settings.ticker_text != blank %}
    <div class="gift-banner__ticker" aria-hidden="true">
      <div class="gift-banner__ticker-track">
        {% for i in (1..6) %}
          <span class="gift-banner__ticker-item">{{ section.settings.ticker_text }}</span>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  /* ============================================================
   * Gift Guide Banner — Layout & Styles
   * ============================================================
   * All pixel values come directly from the Figma CSS export.
   * The 64px offset (for text positions) accounts for the top
   * utility bar height: .box position + 64 = section position.
   *
   * Coordinate reference: section top-left corner = (0, 0).
   * ============================================================ */

  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap');

  .gift-banner {
    position: relative;
    width: 100%;
    max-width: 1440px;
    height: 878px;
    margin: 0 auto;
    overflow: hidden;
    font-family: 'Jost', sans-serif;
    background-color: #ffffff;
  }

  /* ============================================================
   * Background Illustrations
   * ============================================================
   * Two images compose the decorative background:
   *
   * Frame.png (top): Covers full width at the top of the section.
   *   Figma: .frame { top:0, left:0, w:1440, h:390 }
   *   Section: top:64 (below top bar)
   *
   * Frame(1).png (bottom-right): Intentionally NOT full-width.
   *   Figma: .img { top:378, left:550, w:890, h:402 }
   *   Section: top:442 (64+378), left:550
   *   This asymmetric placement leaves the bottom-left quadrant
   *   as clean white space for the text/CTA overlay.
   * ============================================================ */
  .gift-banner__illus {
    position: absolute;
    z-index: 0;
    display: block;
  }

  .gift-banner__illus--custom {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Top illustration — full width, top portion */
  .gift-banner__illus--top {
    top: 64px;
    left: 0;
    width: 1440px;
    height: 390px;
    object-fit: cover;
  }

  /* Bottom illustration — right-aligned, leaves left side clear for text */
  .gift-banner__illus--bottom {
    top: 442px;      /* 64 + 378 from Figma */
    left: 550px;
    width: 890px;
    height: 402px;
    object-fit: cover;
  }

  /* ============================================================
   * Top Utility Bar
   * ============================================================
   * Flex row: logo (left) | subtext (center) | yellow CTA (right)
   * Sits in the top 64px of the section, above the illustrations.
   * ============================================================ */
  .gift-banner__top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 67px;
    height: 64px;
    box-sizing: border-box;
  }

  .gift-banner__logo {
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #000;
    margin: 0;
    white-space: nowrap;
  }

  .gift-banner__top-subtext {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 140%;
    color: #000;
    margin: 0;
    flex: 1;
    text-align: center;
  }

  /* ============================================================
   * Heading — "The Gift Guide"
   * ============================================================
   * Figma: .text-wrapper
   *   top: 54.49% of 780 = 425px → section: 489px (425+64)
   *   left: 4.64% of 1440 = 67px
   *   font: Jost Medium 70px, line-height: 70px, color: #000
   * ============================================================ */
  .gift-banner__heading {
    position: absolute;
    top: 489px;
    left: 67px;
    z-index: 2;
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    font-size: 70px;
    line-height: 70px;
    letter-spacing: 0;
    color: #000;
    margin: 0;
    white-space: nowrap;
  }

  /* ============================================================
   * Description
   * ============================================================
   * Figma: .p
   *   top: 545px → section: 609px (545+64)
   *   left: calc(50% - 655px) ≈ 65px in 1440px → using 67px for alignment
   *   width: 483px, font: Jost Regular 20px, line-height: 28px
   * ============================================================ */
  .gift-banner__description {
    position: absolute;
    top: 609px;
    left: 67px;
    z-index: 2;
    width: 483px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0;
    color: #000;
    margin: 0;
  }

  .gift-banner__description p {
    margin: 0;
  }

  /* ============================================================
   * Buttons — Shared Structure
   * ============================================================
   * Both buttons use the same Figma structure:
   *   - Centered uppercase label
   *   - Right-side horizontal dash (Line 15 from Figma)
   * Hover: dash slides right, label shifts left (300ms ease-out)
   * ============================================================ */
  .gift-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 20.5px;
    text-transform: uppercase;
    border-radius: 0;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Button label — shifts left on hover */
  .gift-banner__btn-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    text-align: center;
    white-space: nowrap;
    transition: transform 300ms ease-out;
  }

  /* Horizontal dash line (Figma: Line 15)
     Positioned at ~78% from left, vertically centered.
     Acts as a minimal arrow indicator. */
  .gift-banner__btn-dash {
    position: absolute;
    left: 77.78%;
    right: 10.63%;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transform: translateY(-50%);
    transition: transform 300ms ease-out;
  }

  /* Hover animation — Smart Animate 300ms ease-out */
  .gift-banner__btn:hover .gift-banner__btn-dash {
    transform: translateY(-50%) translateX(4px);
  }

  .gift-banner__btn:hover .gift-banner__btn-label {
    transform: translateX(-4px);
  }

  /* ---- Yellow CTA (top bar — "CHOOSE GIFT") ----
     Figma: 207×44px, bg: #FFF544, text: #000 */
  .gift-banner__btn--yellow {
    width: 207px;
    height: 44px;
    background-color: #FFF544;
    color: #000;
    font-size: 15px;
    flex-shrink: 0;
  }

  /* ---- Black CTA ("SHOP NOW") ----
     Figma: .component { top:679, left:67, w:220, h:50 }
     Section: top: 743px (679+64) */
  .gift-banner__btn--black {
    position: absolute;
    top: 743px;
    left: 67px;
    width: 220px;
    height: 50px;
    background-color: #000000;
    color: #ffffff;
    font-size: 16px;
    z-index: 2;
  }

  /* ============================================================
   * Bottom Ticker
   * ============================================================
   * Black bar at the absolute bottom of the section.
   * Text scrolls left infinitely via CSS animation.
   * ============================================================ */
  .gift-banner__ticker {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #000;
    overflow: hidden;
    z-index: 3;
    padding: 10px 0;
  }

  .gift-banner__ticker-track {
    display: flex;
    width: max-content;
    animation: gift-ticker-scroll 20s linear infinite;
  }

  .gift-banner__ticker-item {
    color: #fff;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0 40px;
  }

  @keyframes gift-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Accessibility: respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .gift-banner__ticker-track { animation: none; }
    .gift-banner__btn-dash,
    .gift-banner__btn-label { transition: none; }
  }

  /* ============================================================
   * Mobile Responsive (≤749px)
   * ============================================================
   * Collapses to a single-column flow layout.
   * Absolute positioning switches to relative/static for natural
   * stacking. Images scale down proportionally.
   * ============================================================ */
  @media screen and (max-width: 749px) {
    .gift-banner {
      height: auto;
      min-height: 100vh;
      padding-bottom: 40px; /* Space for ticker */
    }

    /* Stack illustrations vertically, scale to fit */
    .gift-banner__illus--top {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      height: auto;
    }

    .gift-banner__illus--bottom {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      height: auto;
    }

    /* Top bar: stack vertically */
    .gift-banner__top {
      position: relative;
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 16px 24px;
    }

    .gift-banner__top-subtext {
      text-align: left;
    }

    /* Text content: switch to static flow */
    .gift-banner__heading {
      position: relative;
      top: auto;
      left: auto;
      padding: 24px 24px 0;
      font-size: 36px;
      line-height: 36px;
      white-space: normal;
    }

    .gift-banner__description {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      padding: 16px 24px 0;
      font-size: 16px;
      line-height: 24px;
    }

    .gift-banner__btn--black {
      position: relative;
      top: auto;
      left: auto;
      width: calc(100% - 48px);
      margin: 24px 24px 0;
    }

    .gift-banner__btn--yellow {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "class": "section-gift-banner",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Custom background image",
      "info": "Optional — overrides the default line-art illustrations. Use 1440×878px."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Tisso Vison"
    },
    {
      "type": "text",
      "id": "top_subtext",
      "label": "Top subtext",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "header",
      "content": "Main content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Bottom button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bottom button link"
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
